{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "affinity": {
      "additionalProperties": true,
      "required": [],
      "title": "affinity",
      "type": "object"
    },
    "env": {
      "description": "Mount Environment variables directly to pod",
      "items": {
        "required": []
      },
      "title": "env",
      "type": "array"
    },
    "envFrom": {
      "description": "Use Environment variables from secret",
      "items": {
        "required": []
      },
      "title": "envFrom",
      "type": "array"
    },
    "fullnameOverride": {
      "default": "",
      "title": "fullnameOverride",
      "type": "string"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "title": "global",
      "type": "object"
    },
    "httpRoute": {
      "additionalProperties": false,
      "description": "Expose the service via gateway-api HTTPRoute\nRequires Gateway API resources and suitable controller installed within the cluster\n(see: https://gateway-api.sigs.k8s.io/guides/)",
      "properties": {
        "annotations": {
          "additionalProperties": false,
          "description": "HTTPRoute annotations.",
          "required": [],
          "title": "annotations",
          "type": "object"
        },
        "enabled": {
          "default": false,
          "description": "HTTPRoute enabled.",
          "title": "enabled",
          "type": "boolean"
        },
        "hostnames": {
          "description": "Hostnames matching HTTP header.",
          "items": {
            "anyOf": [
              {
                "type": "string"
              }
            ],
            "required": []
          },
          "title": "hostnames",
          "type": "array"
        },
        "parentRefs": {
          "description": "Which Gateways this Route is attached to.",
          "items": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "default": "gateway",
                    "title": "name",
                    "type": "string"
                  },
                  "sectionName": {
                    "default": "http",
                    "title": "sectionName",
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "sectionName"
                ],
                "type": "object"
              }
            ],
            "required": []
          },
          "title": "parentRefs",
          "type": "array"
        },
        "rules": {
          "description": "List of rules and filters applied.",
          "items": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "matches": {
                    "items": {
                      "anyOf": [
                        {
                          "additionalProperties": false,
                          "properties": {
                            "path": {
                              "additionalProperties": false,
                              "properties": {
                                "type": {
                                  "default": "PathPrefix",
                                  "title": "type",
                                  "type": "string"
                                },
                                "value": {
                                  "default": "/headers",
                                  "title": "value",
                                  "type": "string"
                                }
                              },
                              "required": [
                                "type",
                                "value"
                              ],
                              "title": "path",
                              "type": "object"
                            }
                          },
                          "required": [
                            "path"
                          ],
                          "type": "object"
                        }
                      ],
                      "required": []
                    },
                    "title": "matches",
                    "type": "array"
                  }
                },
                "required": [
                  "matches"
                ],
                "type": "object"
              }
            ],
            "required": []
          },
          "title": "rules",
          "type": "array"
        }
      },
      "required": [
        "enabled",
        "annotations",
        "parentRefs",
        "hostnames",
        "rules"
      ],
      "title": "httpRoute",
      "type": "object"
    },
    "image": {
      "additionalProperties": false,
      "description": "This sets the container image more information can be found here: https://kubernetes.io/docs/concepts/containers/images/",
      "properties": {
        "name": {
          "default": "durachyo/alertmanager-tg-sender-adapter",
          "description": "Define image name",
          "title": "name",
          "type": "string"
        },
        "pullPolicy": {
          "default": "IfNotPresent",
          "description": "This sets the pull policy for images.",
          "title": "pullPolicy",
          "type": "string"
        },
        "repository": {
          "default": "ghcr.io",
          "title": "repository",
          "type": "string"
        },
        "tag": {
          "default": "",
          "description": "Overrides the image tag whose default is the chart appVersion.",
          "title": "tag",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "name",
        "pullPolicy",
        "tag"
      ],
      "title": "image",
      "type": "object"
    },
    "imagePullSecrets": {
      "description": "This is for the secrets for pulling an image from a private repository more information can be found here: https://kubernetes.io/docs/tasks/configure-pod-container/pull-image-private-registry/",
      "items": {
        "required": []
      },
      "title": "imagePullSecrets",
      "type": "array"
    },
    "ingress": {
      "additionalProperties": false,
      "description": "This block is for setting up the ingress for more information can be found here: https://kubernetes.io/docs/concepts/services-networking/ingress/",
      "properties": {
        "annotations": {
          "additionalProperties": false,
          "required": [],
          "title": "annotations",
          "type": "object"
        },
        "className": {
          "default": "",
          "title": "className",
          "type": "string"
        },
        "enabled": {
          "default": false,
          "title": "enabled",
          "type": "boolean"
        },
        "hosts": {
          "description": "kubernetes.io/ingress.class: nginx\nkubernetes.io/tls-acme: \"true\"",
          "items": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "host": {
                    "default": "chart-example.local",
                    "title": "host",
                    "type": "string"
                  },
                  "paths": {
                    "items": {
                      "anyOf": [
                        {
                          "additionalProperties": false,
                          "properties": {
                            "path": {
                              "default": "/",
                              "title": "path",
                              "type": "string"
                            },
                            "pathType": {
                              "default": "Prefix",
                              "title": "pathType",
                              "type": "string"
                            }
                          },
                          "required": [
                            "path",
                            "pathType"
                          ],
                          "type": "object"
                        }
                      ],
                      "required": []
                    },
                    "title": "paths",
                    "type": "array"
                  }
                },
                "required": [
                  "host",
                  "paths"
                ],
                "type": "object"
              }
            ],
            "required": []
          },
          "title": "hosts",
          "type": "array"
        },
        "tls": {
          "items": {
            "required": []
          },
          "title": "tls",
          "type": "array"
        }
      },
      "required": [
        "enabled",
        "className",
        "annotations",
        "hosts",
        "tls"
      ],
      "title": "ingress",
      "type": "object"
    },
    "istio": {
      "additionalProperties": false,
      "description": "Istio Ingress Gateway (see: https://istio.io/latest/docs/tasks/traffic-management/ingress/ingress-control/)",
      "properties": {
        "enabled": {
          "default": false,
          "title": "enabled",
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "istio",
      "type": "object"
    },
    "livenessProbe": {
      "additionalProperties": false,
      "description": "This is to setup the liveness and readiness probes more information can be found here: https://kubernetes.io/docs/tasks/configure-pod-container/configure-liveness-readiness-startup-probes/",
      "properties": {
        "failureThreshold": {
          "default": 5,
          "title": "failureThreshold",
          "type": "integer"
        },
        "httpGet": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "default": "/health",
              "title": "path",
              "type": "string"
            },
            "port": {
              "default": "http",
              "title": "port",
              "type": "string"
            }
          },
          "required": [
            "path",
            "port"
          ],
          "title": "httpGet",
          "type": "object"
        },
        "initialDelaySeconds": {
          "default": 5,
          "title": "initialDelaySeconds",
          "type": "integer"
        },
        "periodSeconds": {
          "default": 10,
          "title": "periodSeconds",
          "type": "integer"
        }
      },
      "required": [
        "httpGet",
        "initialDelaySeconds",
        "failureThreshold",
        "periodSeconds"
      ],
      "title": "livenessProbe",
      "type": "object"
    },
    "logLevel": {
      "default": "Info",
      "title": "logLevel",
      "type": "string"
    },
    "metrics": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable /metrics api with FastAPI prometheus metrics",
          "title": "enabled",
          "type": "boolean"
        },
        "vmservicescrape": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "default": true,
              "title": "enabled",
              "type": "boolean"
            },
            "endpoints": {
              "items": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "default": "/metrics",
                        "title": "path",
                        "type": "string"
                      },
                      "port": {
                        "default": "http",
                        "title": "port",
                        "type": "string"
                      },
                      "scheme": {
                        "default": "HTTP",
                        "title": "scheme",
                        "type": "string"
                      },
                      "scrape_interval": {
                        "default": "30s",
                        "title": "scrape_interval",
                        "type": "string"
                      }
                    },
                    "required": [
                      "port",
                      "path",
                      "scheme",
                      "scrape_interval"
                    ],
                    "type": "object"
                  }
                ],
                "required": []
              },
              "title": "endpoints",
              "type": "array"
            }
          },
          "required": [
            "enabled",
            "endpoints"
          ],
          "title": "vmservicescrape",
          "type": "object"
        }
      },
      "required": [
        "enabled",
        "vmservicescrape"
      ],
      "title": "metrics",
      "type": "object"
    },
    "nameOverride": {
      "default": "",
      "description": "This is to override the chart name.",
      "title": "nameOverride",
      "type": "string"
    },
    "nodeSelector": {
      "additionalProperties": false,
      "required": [],
      "title": "nodeSelector",
      "type": "object"
    },
    "podAnnotations": {
      "additionalProperties": false,
      "description": "This is for setting Kubernetes Annotations to a Pod.\nFor more information checkout: https://kubernetes.io/docs/concepts/overview/working-with-objects/annotations/",
      "required": [],
      "title": "podAnnotations",
      "type": "object"
    },
    "podLabels": {
      "additionalProperties": false,
      "description": "This is for setting Kubernetes Labels to a Pod.\nFor more information checkout: https://kubernetes.io/docs/concepts/overview/working-with-objects/labels/",
      "required": [],
      "title": "podLabels",
      "type": "object"
    },
    "podSecurityContext": {
      "additionalProperties": false,
      "required": [],
      "title": "podSecurityContext",
      "type": "object"
    },
    "readinessProbe": {
      "additionalProperties": false,
      "properties": {
        "failureThreshold": {
          "default": 3,
          "title": "failureThreshold",
          "type": "integer"
        },
        "httpGet": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "default": "/health",
              "title": "path",
              "type": "string"
            },
            "port": {
              "default": "http",
              "title": "port",
              "type": "string"
            }
          },
          "required": [
            "path",
            "port"
          ],
          "title": "httpGet",
          "type": "object"
        },
        "initialDelaySeconds": {
          "default": 0,
          "title": "initialDelaySeconds",
          "type": "integer"
        },
        "periodSeconds": {
          "default": 5,
          "title": "periodSeconds",
          "type": "integer"
        }
      },
      "required": [
        "httpGet",
        "failureThreshold",
        "periodSeconds",
        "initialDelaySeconds"
      ],
      "title": "readinessProbe",
      "type": "object"
    },
    "replicaCount": {
      "default": 3,
      "description": "Set replicaCount for pod. Default = 3",
      "title": "replicaCount",
      "type": "integer"
    },
    "resources": {
      "additionalProperties": true,
      "required": [],
      "title": "resources",
      "type": "object"
    },
    "securityContext": {
      "additionalProperties": false,
      "required": [],
      "title": "securityContext",
      "type": "object"
    },
    "service": {
      "additionalProperties": false,
      "description": "This is for setting up a service more information can be found here: https://kubernetes.io/docs/concepts/services-networking/service/",
      "properties": {
        "enabled": {
          "default": true,
          "title": "enabled",
          "type": "boolean"
        },
        "ports": {
          "description": "This sets the ports more information can be found here: https://kubernetes.io/docs/concepts/services-networking/service/#field-spec-ports",
          "items": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "default": "http",
                    "title": "name",
                    "type": "string"
                  },
                  "port": {
                    "default": 8080,
                    "title": "port",
                    "type": "integer"
                  },
                  "protocol": {
                    "default": "TCP",
                    "title": "protocol",
                    "type": "string"
                  },
                  "targetPort": {
                    "default": "http",
                    "title": "targetPort",
                    "type": "string"
                  }
                },
                "required": [
                  "port",
                  "targetPort",
                  "protocol",
                  "name"
                ],
                "type": "object"
              }
            ],
            "required": []
          },
          "title": "ports",
          "type": "array"
        },
        "type": {
          "default": "ClusterIP",
          "description": "This sets the service type more information can be found here: https://kubernetes.io/docs/concepts/services-networking/service/#publishing-services-service-types",
          "title": "type",
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "type",
        "ports"
      ],
      "title": "service",
      "type": "object"
    },
    "serviceAccount": {
      "additionalProperties": false,
      "description": "This section builds out the service account more information can be found here: https://kubernetes.io/docs/concepts/security/service-accounts/",
      "properties": {
        "annotations": {
          "additionalProperties": false,
          "description": "Annotations to add to the service account",
          "required": [],
          "title": "annotations",
          "type": "object"
        },
        "automount": {
          "default": true,
          "description": "Automatically mount a ServiceAccount's API credentials?",
          "title": "automount",
          "type": "boolean"
        },
        "create": {
          "default": true,
          "description": "Specifies whether a service account should be created",
          "title": "create",
          "type": "boolean"
        },
        "name": {
          "default": "",
          "description": "The name of the service account to use.\nIf not set and create is true, a name is generated using the fullname template",
          "title": "name",
          "type": "string"
        }
      },
      "required": [
        "create",
        "automount",
        "annotations",
        "name"
      ],
      "title": "serviceAccount",
      "type": "object"
    },
    "tolerations": {
      "items": {
        "required": []
      },
      "title": "tolerations",
      "type": "array"
    },
    "volumeMounts": {
      "description": "Additional volumeMounts on the output Deployment definition.",
      "items": {
        "required": []
      },
      "title": "volumeMounts",
      "type": "array"
    },
    "volumes": {
      "description": "Additional volumes on the output Deployment definition.",
      "items": {
        "required": []
      },
      "title": "volumes",
      "type": "array"
    }
  },
  "required": [
    "image",
    "replicaCount",
    "imagePullSecrets",
    "nameOverride",
    "fullnameOverride",
    "logLevel",
    "serviceAccount",
    "podAnnotations",
    "podLabels",
    "env",
    "envFrom",
    "podSecurityContext",
    "securityContext",
    "service",
    "ingress",
    "istio",
    "httpRoute",
    "resources",
    "livenessProbe",
    "readinessProbe",
    "volumes",
    "volumeMounts",
    "nodeSelector",
    "tolerations",
    "affinity",
    "metrics"
  ],
  "type": "object"
}